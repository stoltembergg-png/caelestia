# Quickshell WebView patch (pragma EnableQtWebEngineQuick)
#
# Origem: quickshell-mirror/quickshell (GPL-3.0) — https://github.com/quickshell-mirror/quickshell
# Base:   2d3b3e9c70ef380dff751b61d334dc88df016c29 (= origin/master, o rev exigido
#         pelo Caelestia).
# Efeito: adiciona src/webengine/webengine.hpp (init dinâmica da QtWebEngineQuick via
#         QLibrary + resolve), liga isso ao pragma `//@ pragma EnableQtWebEngineQuick`
#         lido de shell.qml e ajusta src/CMakeLists.txt. Inclui o build.sh do autor.
# Gerado do working tree do build patchado (working tree é a verdade).
# Licença do Quickshell: GPL-3.0; autoria do patch: usuário. Binários não versionados.

diff --git a/build.sh b/build.sh
new file mode 100755
index 0000000..2d4ad2c
--- /dev/null
+++ b/build.sh
@@ -0,0 +1,25 @@
+#!/usr/bin/env bash
+# Build do Quickshell com patch WebView (PR #351) rebaseado no master 2d3b3e9.
+# Sem jemalloc (evita crash do QtWebEngine), sem testes.
+set -euo pipefail
+
+SRC="$HOME/.local/src/quickshell-webview"
+PREFIX="$HOME/.local/opt/quickshell-webview"
+
+cd "$SRC"
+
+cmake -B build -S . -GNinja \
+  -DCMAKE_BUILD_TYPE=RelWithDebInfo \
+  -DCMAKE_INSTALL_PREFIX="$PREFIX" \
+  -DINSTALL_QML_PREFIX=lib/qt6/qml \
+  -DDISTRIBUTOR="local (webview patch)" \
+  -DUSE_JEMALLOC=OFF \
+  -DBUILD_TESTING=OFF \
+  -DCRASH_REPORTER=OFF
+
+cmake --build build -j"$(nproc)"
+cmake --install build
+
+echo
+echo "Build concluído em $PREFIX"
+echo "Reinicie o shell: serpantinumd stop && serpantinumd start"

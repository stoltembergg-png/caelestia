#!/usr/bin/env bash
#
# scripts/qs — wrapper do Quickshell patchado (WebView / EnableQtWebEngineQuick).
#
# Resolve o binário compilado em ~/.local/opt/quickshell-webview e ajusta
# QML2_IMPORT_PATH/QML_IMPORT_PATH para os módulos QML instalados no prefixo.
# Se o prefixo não existir, cai para o Quickshell do sistema (/usr/bin/qs),
# garantindo que o shell nunca fique sem `qs`.
#
# Variável opcional:
#   QS_WEBVIEW_PREFIX  prefixo de instalação (padrão: ~/.local/opt/quickshell-webview)
#
set -euo pipefail

PREFIX="${QS_WEBVIEW_PREFIX:-$HOME/.local/opt/quickshell-webview}"
BIN="$PREFIX/bin/quickshell"
QML_DIR="$PREFIX/lib/qt6/qml"

if [[ -x "$BIN" ]]; then
	if [[ -d "$QML_DIR" ]]; then
		export QML2_IMPORT_PATH="$QML_DIR${QML2_IMPORT_PATH:+:$QML2_IMPORT_PATH}"
		export QML_IMPORT_PATH="$QML_DIR${QML_IMPORT_PATH:+:$QML_IMPORT_PATH}"
	fi
	exec "$BIN" "$@"
fi

# Fallback: Quickshell stock do sistema (qs é symlink para quickshell).
if [[ -x /usr/bin/qs ]]; then
	exec /usr/bin/qs "$@"
fi

printf 'qs: binário patchado ausente (%s) e /usr/bin/qs não existe\n' "$BIN" >&2
exit 127

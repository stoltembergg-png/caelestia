+
+                    Text {
+                        Layout.alignment: Qt.AlignHCenter
+                        text: "WhatsApp"
+                        font.family: ThemeBackend.fontFamily
+                        font.pixelSize: window.s(12)
+                        color: ThemeBackend.subtext0
+                    }
+                }
+            }
+        }
+    }
+}
